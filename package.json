    "optionator": "0.9.3",
    "picomatch": "^2.3.2",
    "protobufjs": "^7.6.6",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "uuid": "^11.1.1",
    "ws": "^8.22.0"
  },
  "ponstandard": {
    "parser": "@babel/eslint-parser",
    "globals": [
      "btoa"
    ],
    "ignore": [
      "**/__fixtures__/"
