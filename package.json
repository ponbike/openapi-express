    "@opentelemetry/core": "^2.12.0",
    "@protobufjs/utf8": "^1.1.2",
    "@tootallnate/once": "^3.0.1",
    "axios": "^1.20.0",
    "body-parser": "^1.20.9",
    "brace-expansion": "^1.1.21",
