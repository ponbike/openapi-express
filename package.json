    "eslint": "^8.57.1",
    "esm": "^3.2.25",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "jscpd": "^3.5.3",
    "prettier": "^2.8.4",
    "supertest": "^6.3.3"
  },
  "type": "module",
  "engines": {
    "node": ">= 24.22.1"
  },
  "dependencies": {
    "@hckrnews/error": "^1.0.4",
